<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>카페 메뉴 관리</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main>
        <h1>☕ 카페 메뉴 관리</h1>

        <a href="/create" class="add">+ 메뉴 등록</a>

        <% if (menus.length === 0) { %>
            <p>등록된 메뉴가 없습니다.</p>
        <% } %>

        <% menus.forEach(menu => { %>
            <div class="menu">
                <div>
                    <h3><%= menu.name %></h3>
                    <p><%= menu.description || '' %></p>
                    <strong><%= menu.price.toLocaleString() %>원</strong>
                </div>

                <div>
                    <a href="/edit/<%= menu.id %>">수정</a>

                    <form action="/delete/<%= menu.id %>"
                          method="POST"
                          style="display:inline;">
                        <button type="submit">삭제</button>
                    </form>
                </div>
            </div>
        <% }); %>
    </main>
</body>
</html>
